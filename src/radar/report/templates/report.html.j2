<body>
<main>
<header>
<h1>SEC Filing Delta Radar</h1>
<p>Human review of disclosure changes · {{ run.tickers | join(', ') }}</p>
<dl class="meta">
<div><dt>Generated</dt><dd>{{ run.generated_at.isoformat() }}</dd></div>
<div><dt>Run</dt><dd>{{ run.run_id }}</dd></div>
<div><dt>Semantic provider</dt><dd>{{ provider }}</dd></div>
<div><dt>Provider model</dt><dd>{{ provider_model }}</dd></div>
<div><dt>Question schema</dt><dd>{{ run.question_schema_version }}</dd></div>
<div><dt>Comparison strategy</dt><dd>{{ run.strategy }}</dd></div>
<div><dt>Embedding model</dt><dd>{{ run.embedding_model }}</dd></div>
<div><dt>Form</dt><dd>{{ run.form or 'Per-company selection' }}</dd></div>
</dl>
<div class="notice"><strong>Review aid, not investment advice.</strong> Business impact is a source-limited rubric judgment about favorable or adverse business consequences, not stock returns, legal materiality, or public novelty. Categorical probabilities are uncalibrated model judgments, not verified facts. A 0.6 selected-category threshold is a heuristic, not calibrated confidence. Priority and comparison reliability are separate from impact. Alignment can pair unrelated text or miss moved disclosures; review both original filings and all ambiguity warnings. Unmatched passages describe a disclosed matter, not a proven change: no selected counterpart does not establish that information is new, removed, or absent elsewhere in either filing.</div>
<p class="small">Definite impact bands require a selected business-impact probability of at least 0.6. A supported comparison also requires a comparable judgment at that threshold, aligned paragraphs and no recorded alignment-review reasons. Priority follows the impact band only for supported comparisons; uncertain or unmatched assessments enter review. These thresholds are heuristics, not calibrated confidence, and unsupported comparisons can still disclose important matters.</p>
<p class="small">Up to {{ top_n }} leading cards per company form one total reading budget across both lanes, not a budget per lane. Repeated evidence can share a card; every included member retains its original passages and independent judgments. Controls affect only included groups in their own company and lane, never the full saved set. Exact and cosmetic pairs are excluded. Missing cosine, semantics and evidence are unavailable, not zero or reliable. Raw SDK responses remain in the local database; evaluation references identify them.</p>
{% if run.settings.get('embedding_enabled') == false %}<p class="notice">Embedding alignment was disabled. Alignment is lexical-only; cosine similarity is unavailable.</p>{% endif %}
{% if run.settings.get('jev_enabled') == false %}<p class="notice">Semantic evaluation was disabled. Review available lexical changes without semantic judgments.</p>{% endif %}
</header>
{% if run.errors %}
<section class="run-errors" aria-labelledby="run-errors-heading">
<h2 id="run-errors-heading">Run errors</h2>
{% for ticker, error in run.errors.items() %}<div class="error"><h3>{{ ticker }}</h3><p>{{ error }}</p></div>{% endfor %}
</section>
{% endif %}
{% if not companies %}<p class="empty">No company comparisons are available. See run errors for failed requests.</p>{% endif %}
{% for company in companies %}
{% set analysis = company.analysis %}
<section class="company" id="{{ company.id }}" aria-labelledby="{{ company.id }}-heading">
<h2 id="{{ company.id }}-heading">{{ analysis.comparison.current.ticker }} · {{ analysis.comparison.current.company_name }}</h2>
<p class="small">CIK {{ analysis.comparison.current.cik }} · Strategy {{ analysis.comparison.strategy }}</p>
<div class="comparison">
{% for title, filing in [('Previous filing', analysis.comparison.previous), ('Current filing', analysis.comparison.current)] %}
<section class="filing"><h3>{{ title }} · {{ filing.form }}</h3>
<dl class="meta">
<div><dt>Filed</dt><dd>{{ filing.filed_date.isoformat() }}</dd></div>
<div><dt>Period of report</dt><dd>{{ filing.period_of_report.isoformat() if filing.period_of_report else 'Unavailable' }}</dd></div>
<div><dt>Accession</dt><dd>{{ filing.accession }}</dd></div>
<div><dt>Primary document</dt><dd>{{ filing.primary_document }}</dd></div>
</dl>
{% set source = filing.source_url | sec_url %}
{% if source %}<a href="{{ source }}" target="_blank" rel="noopener noreferrer">Open {{ title | lower }} on SEC.gov</a>{% else %}<p class="error">Source link unavailable: not a valid HTTPS SEC URL.</p>{% endif %}
</section>
{% endfor %}
</div>
<div class="counts" aria-label="Full comparison counts">
{% for name, count in analysis.counts.items() %}<span class="badge">{{ name | label }}: {{ count }}</span>{% endfor %}
<span class="badge">Eligible deltas: {{ company.eligible }}</span><span class="badge">Skipped exact/cosmetic pairs: {{ company.skipped }}</span>
{% for band, count in company.priority_counts.items() %}<span class="badge" data-priority-count="{{ band }}">{% if band in ['high', 'medium', 'low'] %}{{ band | label }} priority{% elif band == 'review' %}Review queue{% else %}Priority unavailable{% endif %}: {{ count }}</span>{% endfor %}
</div>
<p class="selection-policy" data-selection-policy="{{ selection_policy }}"><strong>Report selection policy: {{ selection_policy }}.</strong> {% if company.historical %}<strong>Historical mode:</strong> No business assessments or comparison evidence were recorded in this run. Original flat ranking and scores are preserved without grouping or synthesized impact bands.{% else %}Supported high/medium groups have first claim on the {{ top_n }} total leading-card slots. Up to {{ company.reservation }} remaining slots are reserved for assessed review groups; supported low groups then fill capacity before additional review and unavailable groups. Within each category, persisted order is retained. Unavailable judgments do not displace supported low groups; {{ company.review_selected }} review/unavailable groups selected. A group with any unsupported or missing judgment cannot enter the supported lane.{% endif %}</p>
<p class="selection-counts" data-candidate-passages="{{ company.eligible }}" data-total-groups="{{ company.groups }}" data-included-passages="{{ company.included_passages }}" data-omitted-groups="{{ company.omitted_groups }}">{{ company.eligible }} candidate passages → {{ company.groups }} groups; {{ company.deltas | length }} leading cards include {{ company.included_passages }} passages. {{ company.omitted_groups }} groups / {{ company.eligible - company.included_passages }} passages omitted by the reading budget, not judged unimportant. All omitted candidates remain in the saved run.</p>
<p class="small">Saved priority counts above cover candidate passages in the full eligible set, not groups or only the selected subset. Filters match an individual member's categories; all original group members remain inspectable. A grouped summary never replaces their independent judgments. Conservative grouping uses exact fact-change identities or duplicated full event text with matching dates and recorded scope, never a shared broad subject.</p>
{% if analysis.warnings %}<details class="notice diagnostics"><summary>Filing extraction and alignment diagnostics · {{ analysis.warnings | length }} recorded</summary><p>Includes extraction omissions and alignment limitations. Unsupported numeric facts are not used in automatic calculations; inspect these diagnostics and the original filings before drawing conclusions.</p><ul>{% for warning in analysis.warnings %}<li>{{ warning }}</li>{% endfor %}</ul></details>{% endif %}
{% for lane in company.lanes %}
{% set lane_id = company.id ~ '-' ~ lane.key %}
<section class="lane" data-lane="{{ lane.key }}" aria-labelledby="{{ lane_id }}-heading">
<h3 class="lane-heading" id="{{ lane_id }}-heading">{{ lane.title }}</h3>
{% if lane.key == 'review' %}<p class="notice">Review is not a supported business-change claim or an impact band. Potential importance remains uncertain; missing assessments are explicitly unavailable. Inspect comparability, counterparts and every member judgment.</p>{% endif %}
<div class="controls">
<div class="control"><label for="{{ lane_id }}-sort">Sort included groups in this lane</label><select id="{{ lane_id }}-sort" data-control="sort"><option value="rank">Persisted rank (first to last)</option><option value="impact">Recorded impact (high to low, not reliability)</option><option value="cosine">Cosine (lowest first)</option><option value="economic">Economic relevance (highest first)</option></select></div>
<div class="control"><label for="{{ lane_id }}-section">Section</label><select id="{{ lane_id }}-section" data-control="section"><option value="">All sections</option>{% for section in lane.sections %}<option value="{{ section }}">{{ section }}</option>{% endfor %}</select></div>
<div class="control"><label for="{{ lane_id }}-relation">Relation</label><select id="{{ lane_id }}-relation" data-control="relation"><option value="">All relations</option><option value="matched">Matched</option><option value="added">Unmatched current</option><option value="deleted">Unmatched previous</option></select></div>
<div class="control"><label for="{{ lane_id }}-domain">Historical risk domain</label><select id="{{ lane_id }}-domain" data-control="domain"><option value="">All domains</option>{% for key, name in lane.domains %}<option value="{{ key }}">{{ name }}</option>{% endfor %}</select></div>
<div class="control"><label for="{{ lane_id }}-alignment">Alignment status</label><select id="{{ lane_id }}-alignment" data-control="alignment"><option value="">All alignment statuses</option><option value="review">Needs review</option><option value="aligned">Aligned</option><option value="unmatched">Unmatched</option><option value="unavailable">Unavailable (historical)</option></select></div>
{% for filter in lane.category_filters %}
<div class="control"><label for="{{ lane_id }}-{{ filter.key }}">{{ filter.name }}</label><select id="{{ lane_id }}-{{ filter.key }}" data-control="{{ filter.key }}"><option value="">All {{ filter.name | lower }} categories</option>{% for choice in filter.choices %}<option value="{{ choice }}">{{ choice | label }}</option>{% endfor %}</select></div>
{% endfor %}
</div>
<p class="small" role="status" aria-live="polite"><span data-visible-count>{{ lane.deltas | length }}</span> visible / {{ lane.deltas | length }} included / {{ lane.total_groups }} full-set groups in this lane; {{ lane.included_passages }} included / {{ lane.candidate_passages }} full-set candidate passages. Sort keys use the lead passage, except persisted rank uses the group's earliest original rank. Full comparison counts are unchanged by filters.</p>
<noscript><p class="notice">JavaScript is disabled. All included deltas remain readable; interactive sorting and filtering are unavailable.</p></noscript>
<div data-delta-list>
{% for row in lane.deltas %}
{% set delta = row.delta %}{% set pair = delta.pair %}
<article class="delta" data-rank="{{ row.rank }}" data-cosine="{{ pair.cosine_similarity if pair.cosine_similarity is not none else '' }}" data-economic="{{ row.economic if row.economic is not none else '' }}" data-relation="{{ pair.relation }}" data-alignment="{{ row.alignment_status }}" data-sections="{{ row.sections_json }}" data-domains="{{ row.domains_json }}" data-members="{{ row.member_filters_json }}" data-group-reliability="{{ row.group_reliability }}"{% for key, value in row.categories.items() %} data-{{ key }}="{{ value }}"{% endfor %}>
{% if row.members | length > 1 %}
<div class="group-summary"><strong>{{ row.members | length }} source passages · Group comparison: {{ row.group_reliability | label }} · Selection priority: {{ row.group_priority | label }}</strong>
<p>Repeated evidence, not a combined judgment. Any adverse, uncertain or missing member remains relevant. The lead below is passage #{{ row.lead.rank }}.</p>
<ul>{% for member in row.members %}<li>Passage #{{ member.rank }} · Impact {{ member.categories.impact_band | label }} · Direction {{ member.categories.business_direction | label }} · Reliability {{ member.categories.comparison_reliability | label }} · Priority {{ member.priority | label }}</li>{% endfor %}</ul></div>
{% endif %}
{{ passage(row.lead, analysis) }}
{% if row.others %}<details class="group-members"><summary>Other source passages and independent judgments · {{ row.others | length }}</summary>{% for member in row.others %}<section class="group-member">{{ passage(member, analysis) }}</section>{% endfor %}</details>{% endif %}
</article>
{% endfor %}
</div>
<p class="empty" data-no-results {% if lane.deltas %}hidden{% endif %}>{% if lane.deltas %}No included groups match these filters.{% else %}No groups from this lane are included in the reading budget. Full-set lane counts are shown above.{% endif %}</p>
</section>
{% endfor %}
</section>
{% endfor %}
<footer>Filing Delta Radar · Read the original filings before drawing conclusions. This report makes no investment recommendations.</footer>
</main>
<script>
'use strict';
for (const lane of document.querySelectorAll('.lane')) {
  const list = lane.querySelector('[data-delta-list]');
  const cards = Array.from(list.children);
  const controls = Object.fromEntries(Array.from(lane.querySelectorAll('[data-control]'), element => [element.dataset.control, element]));
  const records = cards.map(card => ({card, members: JSON.parse(card.dataset.members)}));
  const number = (card, key, absent) => card.dataset[key] === '' ? absent : Number(card.dataset[key]);
  const categoryKeys = ['business_subject', 'change_nature', 'impact_band', 'business_direction', 'comparison_reliability'];
  const impactOrder = {high: 0, medium: 1, low: 2, unclear: 3, unavailable: 4};
  const update = () => {
    const sort = controls.sort.value;
    records.sort((a, b) => {
      let difference = 0;
      if (sort === 'cosine') difference = number(a.card, 'cosine', Infinity) - number(b.card, 'cosine', Infinity);
      if (sort === 'economic') difference = number(b.card, 'economic', -Infinity) - number(a.card, 'economic', -Infinity);
      if (sort === 'impact') difference = impactOrder[a.card.dataset.impact_band] - impactOrder[b.card.dataset.impact_band];
      return difference || Number(a.card.dataset.rank) - Number(b.card.dataset.rank);
    });
    let visible = 0;
    for (const record of records) {
      const show = record.members.some(member =>
        (!controls.section.value || member.section.includes(controls.section.value))
        && (!controls.relation.value || member.relation === controls.relation.value)
        && (!controls.domain.value || member.domain.includes(controls.domain.value))
        && (!controls.alignment.value || member.alignment === controls.alignment.value)
        && categoryKeys.every(key => !controls[key].value || member[key] === controls[key].value));
      record.card.hidden = !show;
      visible += Number(show);
      list.append(record.card);
    }
    lane.querySelector('[data-visible-count]').textContent = String(visible);
    lane.querySelector('[data-no-results]').hidden = visible !== 0;
  };
  for (const control of Object.values(controls)) control.addEventListener('change', update);
}
</script>
</body>
</html>
