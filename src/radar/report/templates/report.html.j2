{% macro passage(row, analysis) -%}
{% set delta = row.delta %}{% set pair = delta.pair %}
<div class="delta-heading"><h3>#{{ row.rank }} · {{ row.relation_label }} · {{ row.sections | join(' → ') }}</h3><span class="score">Business impact: {{ row.categories.impact_band | label }}</span></div>
<dl class="meta impact-summary">
<div><dt>Business subject</dt><dd>{{ row.categories.business_subject | label }}</dd></div>
<div><dt>Change nature</dt><dd>{{ row.categories.change_nature | label }}</dd></div>
<div><dt>Business direction</dt><dd>{{ row.categories.business_direction | label }}</dd></div>
<div><dt>Review priority</dt><dd>{{ row.priority | label }}</dd></div>
<div><dt>Comparison reliability</dt><dd>{{ row.categories.comparison_reliability | label }}</dd></div>
</dl>
{% if row.dimensions %}
<p class="impact-explanation"><strong>Rubric-based impact explanation:</strong> {{ delta.impact_explanation or 'Unavailable: no explanation was recorded.' }}</p>
<p class="small">{% if pair.relation == 'matched' %}The assessment concerns the selected comparison; comparison reliability determines whether it supports a change claim.{% else %}The assessment concerns the disclosed matter on the available side. Direction is not inferred from an omitted counterpart.{% endif %} Positive and negative consequences receive equal impact treatment.</p>
<details class="impact-details"><summary>Business assessment dimensions, criteria and distributions</summary>
<p class="small">Recorded question schema: {{ delta.signals.question_schema_version }}. Criteria are shown only when that recorded schema matches the installed rubric; otherwise they remain unavailable rather than being replaced with current wording. These are rubric criteria, not generated model reasoning or evidence quotations. Judgments use only supplied passages, metadata and recorded context, not the whole filing. All distributions are uncalibrated. The selected business-impact category can differ from the displayed band below the heuristic threshold.</p>
{% for dimension in row.dimensions %}
<section class="impact-dimension"><h4>{{ dimension.name }}: {{ dimension.choice | label }}</h4>
<p><strong>Selected criterion:</strong> {{ dimension.criterion }}</p>
<ul class="distribution" aria-label="{{ dimension.name }} full probability distribution">
{% for outcome in dimension.distribution %}<li><strong>{{ outcome.choice | label }}: {{ '%.4f' | format(outcome.probability) }}</strong> — {{ outcome.criterion }}</li>{% endfor %}
</ul></section>
{% endfor %}
</details>
{% else %}
<p class="notice impact-unavailable">Business subject, change nature, direction, impact and assessment dimensions are unavailable. Historical signals or missing-provider results are not reinterpreted as a business assessment.</p>
{% endif %}
<div class="metrics"><span class="metric">Cosine: {{ '%.4f' | format(pair.cosine_similarity) if pair.cosine_similarity is not none else 'Unavailable' }}</span><span class="metric">Lexical similarity: {{ '%.4f' | format(pair.lexical_similarity) if pair.lexical_similarity is not none else 'Unavailable' }}</span></div>
{% if row.domains %}<div class="badges" aria-label="Semantic domains">{% for domain in row.domains %}<span class="badge">{{ domain.name }}: {{ domain.direction }}</span>{% endfor %}</div>{% endif %}
<section class="alignment" aria-label="Alignment reliability">
<h4>Alignment reliability: {{ row.alignment_label }}</h4>
{% if pair.alignment %}
{% set alignment = pair.alignment %}
{% if row.alignment_reasons %}<ul class="alignment-reasons">{% for reason in row.alignment_reasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% endif %}
<p class="small">Matching score: {{ '%.4f' | format(alignment.score) if alignment.score is not none else 'Unavailable' }} · Candidate tier: {{ alignment.candidate_tier | label }} · Total assignment margin: {{ '%.6f' | format(alignment.assignment_margin) if alignment.assignment_margin is not none else 'Unavailable' }}</p>
<p class="small">Alignment scores and margins are heuristic, not a probability or economic significance. The margin is the loss in total matching objective for the best feasible competing assignment, conditional on the candidate tier and connected group of candidates considered; it is not a global confidence estimate. An unavailable margin does not establish a reliable match.</p>
<details class="alignment-evidence"><summary>Subsection, reporting scope and matching evidence</summary>
<p class="small">Alignment method: {{ alignment.method }}. Normalized context supports matching only; original filing text and section labels are unchanged.</p>
<div class="comparison">
{% for title, paragraph, context in [('Previous context', pair.old, alignment.old_context), ('Current context', pair.new, alignment.new_context)] %}
<section><h4>{{ title }}</h4>
{% if paragraph %}
<dl><dt>Original item / subsection</dt><dd>{{ paragraph.item or 'Unclassified' }} / {{ paragraph.section or 'Unclassified' }}</dd>
<dt>Normalized subsection</dt><dd>{{ (context.subsection_key or 'Unavailable') if context else 'Unavailable' }}</dd>
<dt>Reporting scope</dt><dd>{{ context.reporting_scope | label if context else 'Unavailable' }}</dd>
<dt>Relative position within subsection</dt><dd>{{ '%.4f' | format(context.subsection_position) if context else 'Unavailable' }}</dd></dl>
<h4>Scope evidence</h4>{% if context and context.scope_evidence %}<ul class="scope-evidence">{% for evidence in context.scope_evidence %}<li>{{ evidence }}</li>{% endfor %}</ul>{% else %}<p class="small">No scope evidence recorded.</p>{% endif %}
{% else %}<p class="absent">Unmatched: no paragraph on this side.</p>{% endif %}
</section>
{% endfor %}
</div>
<h4>Weighted matching score components</h4><p class="small">These contributions belong to paragraph matching, separately from the economic ranking score.</p>
{% if alignment.components %}<table><thead><tr><th scope="col">Component</th><th scope="col">Weighted contribution</th></tr></thead><tbody>{% for name, value in alignment.components.items() %}<tr><th scope="row">{{ name | label }}</th><td>{{ '%+.6f' | format(value) }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="small">No weighted matching components recorded.</p>{% endif %}
</details>
<details class="alignment-alternatives"><summary>{% if 'possible_split_merge' in alignment.review_reasons %}Competing / adjacent pairing evidence{% else %}Competing assignment{% endif %} · {{ alignment.alternatives | length }} recorded pairing(s)</summary>
<p class="small">{% if 'possible_split_merge' in alignment.review_reasons %}The recorded pairings include counterfactual assignment changes and adjacent passages supporting a possible split or merge. Together they are review evidence, not necessarily a single feasible one-to-one alternative.{% else %}The recorded pairings below show changes in a competing assignment, including unmatched sides.{% endif %} Only persisted alternatives are shown; no missing competitors are inferred.</p>
{% for alternative in alignment.alternatives %}
<section class="alignment-alternative"><h4>Competing pairing {{ loop.index }}</h4>
<p class="small">Matching score: {{ '%.4f' | format(alternative.score) if alternative.score is not none else 'Unavailable' }} · Cosine: {{ '%.4f' | format(alternative.cosine_similarity) if alternative.cosine_similarity is not none else 'Unavailable' }}</p>
<div class="comparison">{% for title, paragraph in [('Previous alternative', alternative.old), ('Current alternative', alternative.new)] %}
<section><h4>{{ title }}</h4>{% if paragraph %}<p class="small">Item {{ paragraph.item or 'Unclassified' }} · {{ paragraph.section or 'Unclassified' }} · Paragraph {{ paragraph.ordinal }} · {{ paragraph.paragraph_id }}</p><div class="alternative-excerpt">{{ paragraph.text }}</div>{% else %}<p class="absent">Unmatched: no paragraph on this side.</p>{% endif %}</section>
{% endfor %}</div></section>
{% else %}<p class="small">No competing pairings were recorded. This does not establish that no competing alignment exists.</p>{% endfor %}
</details>
{% else %}
<p class="small">Alignment evidence was not recorded for this historical result. Reliability, normalized scope, assignment margin and competing pairings are unavailable; they are not inferred from cosine similarity or the economic ranking score.</p>
{% endif %}
</section>
{% if pair.warnings %}<div class="notice"><strong>Alignment ambiguity / limitations</strong><ul>{% for warning in pair.warnings %}<li>{{ warning }}</li>{% endfor %}</ul></div>{% endif %}
{% if delta.semantic_error %}<p class="error">Semantic evaluation error: {{ delta.semantic_error }}</p>{% endif %}
{% if delta.signals is none %}<p class="notice">Semantic signals unavailable. This ranking uses only available evidence; no missing semantic probability is treated as a judgment.</p>{% endif %}
<div class="comparison">
{% for title, paragraph in [('Previous text', pair.old), ('Current text', pair.new)] %}
<section><h4>{{ title }}</h4>{% if paragraph %}<p class="small">Item {{ paragraph.item or 'Unclassified' }} · {{ paragraph.section or 'Unclassified' }} · Paragraph {{ paragraph.ordinal }} · {{ paragraph.paragraph_id }}</p><div class="paragraph">{{ paragraph.text }}</div>{% else %}<p class="paragraph absent">No counterpart selected by the aligner. Check the complete filing before inferring absence.</p>{% endif %}</section>
{% endfor %}
</div>
<details class="source-context"><summary>Recorded source context · adjacent and retrieved passages</summary>
<p class="small">Only context supplied with this assessment is shown. It can clarify the selected passage, but is not a complete filing or evidence of public novelty.</p>
<div class="comparison">
{% for side, endpoint in [('previous', pair.old), ('current', pair.new)] %}
<section><h4>{{ side | label }} filing context</h4>
{% for paragraph in delta.source_context.get(side, []) %}
<p class="small">{{ side | label }} side · {% if endpoint and paragraph.ordinal < endpoint.ordinal %}Earlier in filing{% elif endpoint and paragraph.ordinal > endpoint.ordinal %}Later in filing{% else %}Recorded source passage{% endif %} · Accession {{ paragraph.filing_accession }} · Item {{ paragraph.item or 'Unclassified' }} · {{ paragraph.section or 'Unclassified' }} · Paragraph {{ paragraph.ordinal }} · {{ paragraph.paragraph_id }}</p>
<div class="paragraph">{{ paragraph.text }}</div>
{% else %}<p class="absent">No additional source passages recorded on this side.</p>{% endfor %}
</section>
{% endfor %}
</div></details>
{% if delta.comparison_evidence %}
{% set evidence = delta.comparison_evidence %}
<section class="comparison-evidence" aria-label="Recorded comparison evidence">
<h4>Computed numeric comparison basis: {{ evidence.basis | label }}</h4>
<p>{{ evidence.basis_reason }}</p>
<p class="small">Recorded source evidence, not a new judgment. Arithmetic describes numeric changes only; it does not establish a financial consequence, comparability, or public novelty. Explicit fact entities and dates, not table column positions, govern arithmetic.</p>
{% if evidence.uncertainties %}<div class="notice"><strong>Evidence uncertainties</strong><ul>{% for uncertainty in evidence.uncertainties %}<li>{{ uncertainty }}</li>{% endfor %}</ul></div>{% endif %}
{% if evidence.possible_channels %}<p><strong>Possible channels for review (not established effects):</strong> {{ evidence.possible_channels | join('; ') }}</p>{% endif %}
<details class="fact-changes"><summary>Source-cited numeric changes · {{ evidence.changes | length }}</summary>
{% for change in evidence.changes %}
<section><h4>{{ change.metric }} · {{ change.basis | label }}</h4>
<p class="arithmetic">{{ change.current.value }} − ({{ change.previous.value }}) = {{ change.absolute_change }} {{ change.current.unit }}. Relative change: {% if change.percent_change is not none %}{{ change.percent_change }}%{% else %}Unavailable{% endif %}.</p>
<div class="comparison"><section><h4>Previous numeric source</h4>{{ fact_source(change.previous, analysis) }}</section><section><h4>Current numeric source</h4>{{ fact_source(change.current, analysis) }}</section></div>
</section>
{% else %}<p class="absent">No comparable numeric change recorded.</p>{% endfor %}
</details>
<details class="changed-spans"><summary>Recorded changed spans</summary><div class="comparison">
{% for side in ['previous', 'current'] %}<section><h4>{{ side | label }} spans</h4>{% for span in evidence.changed_spans.get(side, []) %}<div class="paragraph">{{ span }}</div>{% else %}<p class="absent">No changed spans recorded on this side.</p>{% endfor %}</section>{% endfor %}
</div></details>
<details class="numeric-context"><summary>Numeric context with source units, entities and periods</summary><div class="comparison">
{% for side in ['previous', 'current'] %}<section><h4>{{ side | label }} numeric context</h4>{% for fact in evidence.context_facts.get(side, []) %}{{ fact_source(fact, analysis) }}{% else %}<p class="absent">No numeric context recorded on this side.</p>{% endfor %}</section>{% endfor %}
</div></details>
<details class="source-tables"><summary>Source table excerpts with original row indices</summary>
<p class="small">Cells below are transcribed in original source-cell order, not a reconstructed column grid. Header flags and spans describe original cells only. Rows can be noncontiguous and headers incomplete; neither adjacency nor position establishes a numeric period.</p>
{% for side in ['previous', 'current'] %}
<h4>{{ side | label }} tables</h4>
{% for table in evidence.tables.get(side, []) %}
<section class="source-table"><h4>{{ table.caption or 'Caption unavailable' }}</h4>
<p class="small">Accession {{ table.filing_accession }} · Table {{ table.table_id }} · Item {{ table.item or 'Unclassified' }} · {{ table.section or 'Unclassified' }} · Anchor {{ table.source_anchor or 'Unavailable' }} {{ source_link(table.filing_accession, table.source_anchor, analysis) }}</p>
<div class="table-scroll" role="region" aria-label="Original source table rows" tabindex="0"><table><thead><tr><th scope="col">Source row index</th><th scope="col">Original cells in source order</th></tr></thead><tbody>
{% for cells in table.rows %}{% set row_index = loop.index0 %}
<tr><th scope="row">{{ table.row_indices[row_index] if row_index < table.row_indices | length else 'Unavailable' }}</th><td><ol class="source-cells">
{% for cell in cells %}{% set cell_index = loop.index0 %}<li>{% if row_index < table.header_cells | length and cell_index < table.header_cells[row_index] | length and table.header_cells[row_index][cell_index] %}<strong>Source header: </strong>{% endif %}<span>{{ cell }}</span>{% if row_index < table.cell_spans | length and cell_index < table.cell_spans[row_index] | length %}<span class="small"> (source rowspan {{ table.cell_spans[row_index][cell_index][0] }}, colspan {{ table.cell_spans[row_index][cell_index][1] }})</span>{% endif %}</li>{% endfor %}
</ol></td></tr>{% endfor %}
</tbody></table></div></section>
{% else %}<p class="absent">No table excerpt recorded on this side.</p>{% endfor %}
{% endfor %}
</details>
<details class="counterpart-candidates"><summary>Possible counterpart passages, not selected comparisons</summary>
{% for side in ['previous', 'current'] %}<section><h4>{{ side | label }} candidates</h4>{% for paragraph in evidence.counterparts.get(side, []) %}<p class="small">Accession {{ paragraph.filing_accession }} · Item {{ paragraph.item or 'Unclassified' }} · {{ paragraph.section or 'Unclassified' }} · Paragraph {{ paragraph.ordinal }} · {{ paragraph.paragraph_id }} {{ source_link(paragraph.filing_accession, none, analysis) }}</p><div class="paragraph">{{ paragraph.text }}</div>{% else %}<p class="absent">No counterpart candidate recorded; this does not prove absence.</p>{% endfor %}</section>{% endfor %}
</details>
</section>
{% else %}<p class="notice evidence-unavailable">Comparison evidence unavailable: no structured evidence was recorded. Historical results are not reparsed or rejudged.</p>{% endif %}
<details><summary>Word-level change · deleted / inserted text</summary><p class="small">Deletions are struck through; insertions are underlined. Word diff is lexical, not a semantic explanation.</p><div class="diff">{{ row.diff }}</div></details>
<details class="ranking-details"><summary>Within-band tiebreaker / historical score and semantic details</summary>
<h4>Weighted heuristic score: {{ '%.4f' | format(delta.score) }}</h4><p class="small">This is a within-band tiebreaker or historical ranking heuristic, not a business-impact factor or probability. The contributions are already weighted; their sum is the score, and displayed rounding may differ.</p>
<div class="table-scroll" role="region" aria-label="Weighted ranking contributions" tabindex="0"><table><thead><tr><th scope="col">Component</th><th scope="col">Contribution</th></tr></thead><tbody>{% for name, value in delta.components.items() %}<tr><th scope="row">{{ name | label }}</th><td>{{ '%+.6f' | format(value) }}</td></tr>{% endfor %}</tbody></table></div>
{% if delta.signals %}
<h4>Normalized semantic judgments</h4><p class="small">Question schema {{ delta.signals.question_schema_version }}. Binary values below are P(yes). Unavailable fields were not evaluated or not returned.</p>
<div class="table-scroll" role="region" aria-label="Binary semantic probabilities" tabindex="0"><table><thead><tr><th scope="col">Signal</th><th scope="col">P(yes)</th></tr></thead><tbody>{% for signal in row.scalar_signals %}<tr><th scope="row">{{ signal.name }}</th><td>{{ '%.4f' | format(signal.value) if signal.value is not none else 'Unavailable' }}</td></tr>{% endfor %}</tbody></table></div>
<h4>Historical risk-domain judgments</h4><p class="small">Legacy risk directions and their uncalibrated distributions are preserved when recorded; they are not substituted for business direction or impact.</p>
<div class="table-scroll" role="region" aria-label="Historical risk-domain probabilities" tabindex="0"><table><thead><tr><th scope="col">Domain</th><th scope="col">Direction</th><th scope="col">Probabilities</th></tr></thead><tbody>{% for domain in row.directions %}<tr><th scope="row">{{ domain.name }}</th><td>{{ domain.direction if domain.direction is not none else 'Unavailable' }}</td><td>{% if domain.probabilities is not none %}<ul class="probabilities">{% for choice, probability in domain.probabilities.items() %}<li>{{ choice }}: {{ '%.4f' | format(probability) }}</li>{% endfor %}</ul>{% else %}Unavailable{% endif %}</td></tr>{% endfor %}</tbody></table></div>
{% endif %}
<p class="small reference">Evaluation reference: <code>{{ delta.evaluation_key or 'Unavailable' }}</code></p>
</details>
{%- endmacro %}
{% macro source_link(accession, anchor, analysis) -%}
{% for filing in [analysis.comparison.previous, analysis.comparison.current] if filing.accession == accession %}
{% set source = filing.source_url | sec_url %}
{% if source %}<a href="{{ source.split('#')[0] ~ '#' ~ (anchor | urlencode) if anchor else source }}" target="_blank" rel="noopener noreferrer">Open cited SEC source{% if anchor %} at anchor{% endif %}</a>{% else %}<span class="absent">Source link unavailable.</span>{% endif %}
{% endfor %}
{%- endmacro %}
{% macro fact_source(fact, analysis) -%}
<div class="source-fact">
<p><strong>{{ fact.label }}:</strong> {{ fact.value }} {{ fact.unit }} · Entity {{ fact.entity }} · Period {% if fact.period_start %}{{ fact.period_start }} to {% else %}instant {% endif %}{{ fact.period_end }}</p>
<p class="small">Concept {{ fact.concept }} · Accession {{ fact.filing_accession }} · Fact {{ fact.fact_id }} · Anchor {{ fact.source_anchor or 'Unavailable' }} · Paragraphs {{ fact.paragraph_ids | join(', ') or 'Unavailable' }} · Table {{ fact.table_id or 'Unavailable' }} · Source scale {{ fact.scale }} · Source sign {{ fact.sign or 'Not specified' }} · Source format {{ fact.format or 'Not specified' }}</p>
{% if fact.dimensions %}<ul>{% for dimension, value in fact.dimensions.items() %}<li>{{ dimension }}: {{ value }}</li>{% endfor %}</ul>{% endif %}
<blockquote class="paragraph">{{ fact.quote }}</blockquote>{{ source_link(fact.filing_accession, fact.source_anchor, analysis) }}
</div>
{%- endmacro %}
