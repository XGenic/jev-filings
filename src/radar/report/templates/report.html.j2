mary{cursor:pointer;font-weight:650;padding:8px 0}details{margin-top:8px}.diff{padding:12px;background:#f8fafc}del{background:#ffdcd8;text-decoration:line-through}ins{background:#d4efdf;text-decoration:underline}table{border-collapse:collapse;width:100%;font-size:.9rem}th,td{text-align:left;vertical-align:top;padding:7px;border-bottom:1px solid var(--line);overflow-wrap:anywhere}th{font-weight:650}.probabilities{margin:0;padding-left:18px}.reference{overflow-wrap:anywhere}ul{padding-left:22px}.empty{padding:20px;color:var(--muted);background:#f4f7fa}footer{margin:24px 0;color:var(--muted)}[hidden]{display:none!important}@media(max-width:720px){main{padding:12px}header,.company,.run-errors{padding:14px}.comparison{grid-template-columns:1fr}.delta-heading{display:block}select{max-width:100%}.control{min-width:0;flex:1 1 140px}.meta{grid-template-columns:1fr 1fr}article.delta{padding:12px}}@media print{body{background:white}main{max-width:none;padding:0}.controls{display:none}.company,article.delta{break-inside:avoid}details{display:block}header,.company{border-radius:0}}
.alignment{border:1px solid var(--line);border-radius:8px;padding:14px;margin:14px 0}.alignment-reasons{border-left:4px solid #c46700;padding-left:24px}.alignment-alternative{border-top:1px solid var(--line);padding:14px 0}.alternative-excerpt{white-space:pre-wrap;overflow-wrap:anywhere}.alignment .small,.alignment li{overflow-wrap:anywhere}
.score{white-space:normal;min-width:12rem}
.impact-summary{margin:14px 0}.impact-dimension{border-top:1px solid var(--line);padding:12px 0}.impact-dimension h4,.impact-dimension p,.source-context p{overflow-wrap:anywhere}.distribution{margin:8px 0}.distribution li{margin-bottom:8px;overflow-wrap:anywhere}.table-scroll{max-width:100%;overflow-x:auto}.source-context .paragraph{margin-bottom:12px}.controls .control{max-width:100%}@media(max-width:480px){.meta{grid-template-columns:1fr}.impact-summary{gap:8px}.score{min-width:0}.controls select{width:100%}.table-scroll table{min-width:280px}}
