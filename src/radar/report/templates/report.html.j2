<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>SEC Filing Delta Radar · {{ run.run_id }}</title>
<style>
:root{color-scheme:light;--ink:#14243a;--muted:#53627a;--line:#ccd6e3;--paper:#fff;--accent:#175780}
*{box-sizing:border-box}body{margin:0;background:#edf2f7;color:var(--ink);font:15px/1.55 system-ui,sans-serif}main{max-width:1440px;margin:auto;padding:24px}h1,h2,h3,h4,p{margin:0 0 12px}h1{font-size:1.85rem}h2{font-size:1.4rem}h3{font-size:1.1rem}h4{font-size:1rem}a{color:var(--accent)}a:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #c46700;outline-offset:3px}header,.company,.run-errors{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:22px;margin-bottom:22px}dl{margin:0}dt{font-weight:650}dd{margin:0;overflow-wrap:anywhere}.meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}.small,.muted{color:var(--muted);font-size:.88rem}.notice{background:#fff5d9;border-left:4px solid #ba8100;padding:12px;margin:12px 0}.error{background:#fff0ee;border-left:4px solid #ad352b;padding:12px;overflow-wrap:anywhere}.comparison{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}.filing{background:#f4f7fa;padding:14px;border-radius:6px}.counts,.badges,.metrics{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.badge,.metric{border:1px solid var(--line);background:#f4f7fa;padding:3px 9px;border-radius:6px;font-size:.85rem}.controls{display:flex;flex-wrap:wrap;gap:12px;border-block:1px solid var(--line);padding:14px 0;margin:18px 0 8px}.control{display:flex;flex-direction:column;gap:4px;min-width:150px}label{font-weight:650;font-size:.85rem}select{font:inherit;color:inherit;background:white;border:1px solid #78899e;border-radius:5px;padding:7px;max-width:320px}article.delta{border:1px solid var(--line);border-radius:8px;padding:18px;margin-top:16px}.delta-heading{display:flex;justify-content:space-between;gap:16px;align-items:baseline}.score{font-variant-numeric:tabular-nums;font-weight:700;white-space:nowrap}.paragraph,.diff{white-space:pre-wrap;overflow-wrap:anywhere}.paragraph{padding:12px;background:#f5f7fa;border-radius:6px}.absent{font-style:italic;color:var(--muted)}summary{cursor:pointer;font-weight:650;padding:8px 0}details{margin-top:8px}.diff{padding:12px;background:#f8fafc}del{background:#ffdcd8;text-decoration:line-through}ins{background:#d4efdf;text-decoration:underline}table{border-collapse:collapse;width:100%;font-size:.9rem}th,td{text-align:left;vertical-align:top;padding:7px;border-bottom:1px solid var(--line);overflow-wrap:anywhere}th{font-weight:650}.probabilities{margin:0;padding-left:18px}.reference{overflow-wrap:anywhere}ul{padding-left:22px}.empty{padding:20px;color:var(--muted);background:#f4f7fa}footer{margin:24px 0;color:var(--muted)}[hidden]{display:none!important}@media(max-width:720px){main{padding:12px}header,.company,.run-errors{padding:14px}.comparison{grid-template-columns:1fr}.delta-heading{display:block}select{max-width:100%}.control{min-width:0;flex:1 1 140px}.meta{grid-template-columns:1fr 1fr}article.delta{padding:12px}}@media print{body{background:white}main{max-width:none;padding:0}.controls{display:none}.company,article.delta{break-inside:avoid}details{display:block}header,.company{border-radius:0}}
.alignment{border:1px solid var(--line);border-radius:8px;padding:14px;margin:14px 0}.alignment-reasons{border-left:4px solid #c46700;padding-left:24px}.alignment-alternative{border-top:1px solid var(--line);padding:14px 0}.alternative-excerpt{white-space:pre-wrap;overflow-wrap:anywhere}.alignment .small,.alignment li{overflow-wrap:anywhere}
.score{white-space:normal;min-width:12rem}
</style>
</head>
<body>
<main>
<header>
<h1>SEC Filing Delta Radar</h1>
<p>Human review of disclosure changes · {{ run.tickers | join(', ') }}</p>
<dl class="meta">
<div><dt>Generated</dt><dd>{{ run.generated_at.isoformat() }}</dd></div>
<div><dt>Run</dt><dd>{{ run.run_id }}</dd></div>
<div><dt>Semantic provider</dt><dd>{{ provider }}</dd></div>
<div><dt>Provider model</dt><dd>{{ provider_model }}</dd></div>
<div><dt>Question schema</dt><dd>{{ run.question_schema_version }}</dd></div>
<div><dt>Comparison strategy</dt><dd>{{ run.strategy }}</dd></div>
<div><dt>Embedding model</dt><dd>{{ run.embedding_model }}</dd></div>
<div><dt>Form</dt><dd>{{ run.form or 'Per-company selection' }}</dd></div>
</dl>
<div class="notice"><strong>Review aid, not investment advice.</strong> Scores are weighted heuristic ranking values, not probabilities or investment recommendations. Semantic probabilities are model judgments, not verified facts. Alignment can pair unrelated text or miss moved disclosures; review both original filings and all ambiguity warnings. Unmatched passages have no selected counterpart: this does not establish that information is new, removed, or absent elsewhere in either filing.</div>
<p class="small">Up to {{ top_n }} non-skipped deltas per company are included, in persisted ranking order. Controls sort and filter only this included subset; source counts do not change. Exact and cosmetic pairs are excluded. Missing cosine or semantic signals are unavailable, not zero. Lexical-only alignment and missing semantic evaluations provide reduced evidence. Raw SDK responses remain in the local database; evaluation references below identify them.</p>
{% if run.settings.get('embedding_enabled') == false %}<p class="notice">Embedding alignment was disabled. Alignment is lexical-only; cosine similarity is unavailable.</p>{% endif %}
{% if run.settings.get('jev_enabled') == false %}<p class="notice">Semantic evaluation was disabled. Review available lexical changes without semantic judgments.</p>{% endif %}
</header>
{% if run.errors %}
<section class="run-errors" aria-labelledby="run-errors-heading">
<h2 id="run-errors-heading">Run errors</h2>
{% for ticker, error in run.errors.items() %}<div class="error"><h3>{{ ticker }}</h3><p>{{ error }}</p></div>{% endfor %}
</section>
{% endif %}
{% if not companies %}<p class="empty">No company comparisons are available. See run errors for failed requests.</p>{% endif %}
{% for company in companies %}
{% set analysis = company.analysis %}
<section class="company" id="{{ company.id }}" aria-labelledby="{{ company.id }}-heading">
<h2 id="{{ company.id }}-heading">{{ analysis.comparison.current.ticker }} · {{ analysis.comparison.current.company_name }}</h2>
<p class="small">CIK {{ analysis.comparison.current.cik }} · Strategy {{ analysis.comparison.strategy }}</p>
<div class="comparison">
{% for title, filing in [('Previous filing', analysis.comparison.previous), ('Current filing', analysis.comparison.current)] %}
<section class="filing"><h3>{{ title }} · {{ filing.form }}</h3>
<dl class="meta">
<div><dt>Filed</dt><dd>{{ filing.filed_date.isoformat() }}</dd></div>
<div><dt>Period of report</dt><dd>{{ filing.period_of_report.isoformat() if filing.period_of_report else 'Unavailable' }}</dd></div>
<div><dt>Accession</dt><dd>{{ filing.accession }}</dd></div>
<div><dt>Primary document</dt><dd>{{ filing.primary_document }}</dd></div>
</dl>
{% set source = filing.source_url | sec_url %}
{% if source %}<a href="{{ source }}" target="_blank" rel="noopener noreferrer">Open {{ title | lower }} on SEC.gov</a>{% else %}<p class="error">Source link unavailable: not a valid HTTPS SEC URL.</p>{% endif %}
</section>
{% endfor %}
</div>
<div class="counts" aria-label="Full comparison counts">
{% for name, count in analysis.counts.items() %}<span class="badge">{{ name | label }}: {{ count }}</span>{% endfor %}
<span class="badge">Eligible deltas: {{ company.eligible }}</span><span class="badge">Skipped exact/cosmetic pairs: {{ company.skipped }}</span>
</div>
{% if analysis.warnings %}<div class="notice"><strong>Limitations and alignment warnings</strong><ul>{% for warning in analysis.warnings %}<li>{{ warning }}</li>{% endfor %}</ul></div>{% endif %}
<div class="controls">
<div class="control"><label for="{{ company.id }}-sort">Sort included deltas</label><select id="{{ company.id }}-sort" data-control="sort"><option value="rank">Rank (best first)</option><option value="cosine">Cosine (lowest first)</option><option value="economic">Economic relevance (highest first)</option></select></div>
<div class="control"><label for="{{ company.id }}-section">Section</label><select id="{{ company.id }}-section" data-control="section"><option value="">All sections</option>{% for section in company.sections %}<option value="{{ section }}">{{ section }}</option>{% endfor %}</select></div>
<div class="control"><label for="{{ company.id }}-relation">Relation</label><select id="{{ company.id }}-relation" data-control="relation"><option value="">All relations</option><option value="matched">Matched</option><option value="added">Unmatched current</option><option value="deleted">Unmatched previous</option></select></div>
<div class="control"><label for="{{ company.id }}-domain">Domain</label><select id="{{ company.id }}-domain" data-control="domain"><option value="">All domains</option>{% for key, name in company.domains %}<option value="{{ key }}">{{ name }}</option>{% endfor %}</select></div>
<div class="control"><label for="{{ company.id }}-alignment">Alignment status</label><select id="{{ company.id }}-alignment" data-control="alignment"><option value="">All alignment statuses</option><option value="review">Needs review</option><option value="aligned">Aligned</option><option value="unmatched">Unmatched</option><option value="unavailable">Unavailable (historical)</option></select></div>
</div>
<p class="small" role="status" aria-live="polite"><span data-visible-count>{{ company.deltas | length }}</span> visible / {{ company.deltas | length }} included / {{ company.eligible }} eligible deltas. Full comparison counts above are unchanged by filters.</p>
<noscript><p class="notice">JavaScript is disabled. All included deltas remain readable; interactive sorting and filtering are unavailable.</p></noscript>
<div data-delta-list>
{% for row in company.deltas %}
{% set delta = row.delta %}{% set pair = delta.pair %}
<article class="delta" data-rank="{{ row.rank }}" data-cosine="{{ pair.cosine_similarity if pair.cosine_similarity is not none else '' }}" data-economic="{{ row.economic if row.economic is not none else '' }}" data-relation="{{ pair.relation }}" data-alignment="{{ row.alignment_status }}" data-sections="{{ row.sections_json }}" data-domains="{{ row.domains_json }}">
<div class="delta-heading"><h3>#{{ row.rank }} · {{ row.relation_label }} · {{ row.sections | join(' → ') }}</h3><span class="score">Heuristic economic ranking score {{ '%.4f' | format(delta.score) }}</span></div>
<div class="metrics"><span class="metric">Cosine: {{ '%.4f' | format(pair.cosine_similarity) if pair.cosine_similarity is not none else 'Unavailable' }}</span><span class="metric">Lexical similarity: {{ '%.4f' | format(pair.lexical_similarity) if pair.lexical_similarity is not none else 'Unavailable' }}</span></div>
{% if row.domains %}<div class="badges" aria-label="Semantic domains">{% for domain in row.domains %}<span class="badge">{{ domain.name }}: {{ domain.direction }}</span>{% endfor %}</div>{% endif %}
<section class="alignment" aria-label="Alignment reliability">
<h4>Alignment reliability: {{ row.alignment_label }}</h4>
{% if pair.alignment %}
{% set alignment = pair.alignment %}
{% if row.alignment_reasons %}<ul class="alignment-reasons">{% for reason in row.alignment_reasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% endif %}
<p class="small">Matching score: {{ '%.4f' | format(alignment.score) if alignment.score is not none else 'Unavailable' }} · Candidate tier: {{ alignment.candidate_tier | label }} · Total assignment margin: {{ '%.6f' | format(alignment.assignment_margin) if alignment.assignment_margin is not none else 'Unavailable' }}</p>
<p class="small">Alignment scores and margins are heuristic, not a probability or economic significance. The margin is the loss in total matching objective for the best feasible competing assignment, conditional on the candidate tier and connected group of candidates considered; it is not a global confidence estimate. An unavailable margin does not establish a reliable match.</p>
<details class="alignment-evidence"><summary>Subsection, reporting scope and matching evidence</summary>
<p class="small">Alignment method: {{ alignment.method }}. Normalized context supports matching only; original filing text and section labels are unchanged.</p>
<div class="comparison">
{% for title, paragraph, context in [('Previous context', pair.old, alignment.old_context), ('Current context', pair.new, alignment.new_context)] %}
<section><h4>{{ title }}</h4>
{% if paragraph %}
<dl><dt>Original item / subsection</dt><dd>{{ paragraph.item or 'Unclassified' }} / {{ paragraph.section or 'Unclassified' }}</dd>
<dt>Normalized subsection</dt><dd>{{ (context.subsection_key or 'Unavailable') if context else 'Unavailable' }}</dd>
<dt>Reporting scope</dt><dd>{{ context.reporting_scope | label if context else 'Unavailable' }}</dd>
<dt>Relative position within subsection</dt><dd>{{ '%.4f' | format(context.subsection_position) if context else 'Unavailable' }}</dd></dl>
<h4>Scope evidence</h4>{% if context and context.scope_evidence %}<ul class="scope-evidence">{% for evidence in context.scope_evidence %}<li>{{ evidence }}</li>{% endfor %}</ul>{% else %}<p class="small">No scope evidence recorded.</p>{% endif %}
{% else %}<p class="absent">Unmatched: no paragraph on this side.</p>{% endif %}
</section>
{% endfor %}
</div>
<h4>Weighted matching score components</h4><p class="small">These contributions belong to paragraph matching, separately from the economic ranking score.</p>
{% if alignment.components %}<table><thead><tr><th scope="col">Component</th><th scope="col">Weighted contribution</th></tr></thead><tbody>{% for name, value in alignment.components.items() %}<tr><th scope="row">{{ name | label }}</th><td>{{ '%+.6f' | format(value) }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="small">No weighted matching components recorded.</p>{% endif %}
</details>
<details class="alignment-alternatives"><summary>{% if 'possible_split_merge' in alignment.review_reasons %}Competing / adjacent pairing evidence{% else %}Competing assignment{% endif %} · {{ alignment.alternatives | length }} recorded pairing(s)</summary>
<p class="small">{% if 'possible_split_merge' in alignment.review_reasons %}The recorded pairings include counterfactual assignment changes and adjacent passages supporting a possible split or merge. Together they are review evidence, not necessarily a single feasible one-to-one alternative.{% else %}The recorded pairings below show changes in a competing assignment, including unmatched sides.{% endif %} Only persisted alternatives are shown; no missing competitors are inferred.</p>
{% for alternative in alignment.alternatives %}
<section class="alignment-alternative"><h4>Competing pairing {{ loop.index }}</h4>
<p class="small">Matching score: {{ '%.4f' | format(alternative.score) if alternative.score is not none else 'Unavailable' }} · Cosine: {{ '%.4f' | format(alternative.cosine_similarity) if alternative.cosine_similarity is not none else 'Unavailable' }}</p>
<div class="comparison">{% for title, paragraph in [('Previous alternative', alternative.old), ('Current alternative', alternative.new)] %}
<section><h4>{{ title }}</h4>{% if paragraph %}<p class="small">Item {{ paragraph.item or 'Unclassified' }} · {{ paragraph.section or 'Unclassified' }} · Paragraph {{ paragraph.ordinal }} · {{ paragraph.paragraph_id }}</p><div class="alternative-excerpt">{{ paragraph.text }}</div>{% else %}<p class="absent">Unmatched: no paragraph on this side.</p>{% endif %}</section>
{% endfor %}</div></section>
{% else %}<p class="small">No competing pairings were recorded. This does not establish that no competing alignment exists.</p>{% endfor %}
</details>
{% else %}
<p class="small">Alignment evidence was not recorded for this historical result. Reliability, normalized scope, assignment margin and competing pairings are unavailable; they are not inferred from cosine similarity or the economic ranking score.</p>
{% endif %}
</section>
{% if pair.warnings %}<div class="notice"><strong>Alignment ambiguity / limitations</strong><ul>{% for warning in pair.warnings %}<li>{{ warning }}</li>{% endfor %}</ul></div>{% endif %}
{% if delta.semantic_error %}<p class="error">Semantic evaluation error: {{ delta.semantic_error }}</p>{% endif %}
{% if delta.signals is none %}<p class="notice">Semantic signals unavailable. This ranking uses only available evidence; no missing semantic probability is treated as a judgment.</p>{% endif %}
<div class="comparison">
{% for title, paragraph in [('Previous text', pair.old), ('Current text', pair.new)] %}
<section><h4>{{ title }}</h4>{% if paragraph %}<p class="small">Item {{ paragraph.item or 'Unclassified' }} · {{ paragraph.section or 'Unclassified' }} · Paragraph {{ paragraph.ordinal }} · {{ paragraph.paragraph_id }}</p><div class="paragraph">{{ paragraph.text }}</div>{% else %}<p class="paragraph absent">No counterpart selected by the aligner. Check the complete filing before inferring absence.</p>{% endif %}</section>
{% endfor %}
</div>
<details><summary>Word-level change · deleted / inserted text</summary><p class="small">Deletions are struck through; insertions are underlined. Word diff is lexical, not a semantic explanation.</p><div class="diff">{{ row.diff }}</div></details>
<details><summary>Economic ranking contributions and semantic details</summary>
<h4>Weighted economic ranking contributions</h4><p class="small">These are already weighted contributions, not raw probabilities. Their sum is the heuristic economic ranking score; displayed rounding may differ.</p>
<table><thead><tr><th scope="col">Component</th><th scope="col">Contribution</th></tr></thead><tbody>{% for name, value in delta.components.items() %}<tr><th scope="row">{{ name | label }}</th><td>{{ '%+.6f' | format(value) }}</td></tr>{% endfor %}</tbody></table>
{% if delta.signals %}
<h4>Normalized semantic judgments</h4><p class="small">Question schema {{ delta.signals.question_schema_version }}. Binary values below are P(yes); categorical values show the selected direction and full probability distribution. Unavailable fields were not evaluated or not returned.</p>
<table><thead><tr><th scope="col">Signal</th><th scope="col">P(yes)</th></tr></thead><tbody>{% for signal in row.scalar_signals %}<tr><th scope="row">{{ signal.name }}</th><td>{{ '%.4f' | format(signal.value) if signal.value is not none else 'Unavailable' }}</td></tr>{% endfor %}</tbody></table>
<table><thead><tr><th scope="col">Domain</th><th scope="col">Direction</th><th scope="col">Probabilities</th></tr></thead><tbody>{% for domain in row.directions %}<tr><th scope="row">{{ domain.name }}</th><td>{{ domain.direction if domain.direction is not none else 'Unavailable' }}</td><td>{% if domain.probabilities is not none %}<ul class="probabilities">{% for choice, probability in domain.probabilities.items() %}<li>{{ choice }}: {{ '%.4f' | format(probability) }}</li>{% endfor %}</ul>{% else %}Unavailable{% endif %}</td></tr>{% endfor %}</tbody></table>
{% endif %}
<p class="small reference">Evaluation reference: <code>{{ delta.evaluation_key or 'Unavailable' }}</code></p>
</details>
</article>
{% endfor %}
</div>
<p class="empty" data-no-results {% if company.deltas %}hidden{% endif %}>{% if company.deltas %}No included deltas match these filters.{% else %}No non-skipped deltas are available for this comparison.{% endif %}</p>
</section>
{% endfor %}
<footer>Filing Delta Radar · Read the original filings before drawing conclusions. This report makes no investment recommendations.</footer>
</main>
<script>
'use strict';
for (const company of document.querySelectorAll('.company')) {
  const list = company.querySelector('[data-delta-list]');
  const cards = Array.from(list.children);
  const controls = Object.fromEntries(Array.from(company.querySelectorAll('[data-control]'), element => [element.dataset.control, element]));
  const records = cards.map(card => ({card, sections: JSON.parse(card.dataset.sections), domains: JSON.parse(card.dataset.domains)}));
  const number = (card, key, absent) => card.dataset[key] === '' ? absent : Number(card.dataset[key]);
  const update = () => {
    const sort = controls.sort.value;
    records.sort((a, b) => {
      let difference = 0;
      if (sort === 'cosine') difference = number(a.card, 'cosine', Infinity) - number(b.card, 'cosine', Infinity);
      if (sort === 'economic') difference = number(b.card, 'economic', -Infinity) - number(a.card, 'economic', -Infinity);
      return difference || Number(a.card.dataset.rank) - Number(b.card.dataset.rank);
    });
    let visible = 0;
    for (const record of records) {
      const show = (!controls.section.value || record.sections.includes(controls.section.value))
        && (!controls.relation.value || record.card.dataset.relation === controls.relation.value)
        && (!controls.domain.value || record.domains.includes(controls.domain.value))
        && (!controls.alignment.value || record.card.dataset.alignment === controls.alignment.value);
      record.card.hidden = !show;
      visible += Number(show);
      list.append(record.card);
    }
    company.querySelector('[data-visible-count]').textContent = String(visible);
    company.querySelector('[data-no-results]').hidden = visible !== 0;
  };
  for (const control of Object.values(controls)) control.addEventListener('change', update);
}
</script>
</body>
</html>
